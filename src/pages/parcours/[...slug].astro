---
import { getCollection, render } from 'astro:content';
import ParcoursLayout from '../../layouts/ParcoursLayout.astro';
import TourMap from '../../components/TourMap.astro';
import StopsList from '../../components/StopsList.astro';
import { colorForCircuit } from '../../lib/parcours.ts';

export async function getStaticPaths() {
  const parcours = await getCollection('parcours', ({ data }) => !data.draft);
  return parcours.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Charger TOUS les stops.json de tous les parcours non-brouillons, pour les agréger
// sur la carte partagée. Astro résout les chemins de glob à la racine du projet.
const stopsModules = import.meta.glob<{ default: any[] }>('../../content/parcours/**/stops.json', { eager: true });

// Construire la liste des tracks pour la carte (un track par parcours), triés par date
// croissante pour que la légende suive la chronologie.
const allParcours = await getCollection('parcours', ({ data }) => !data.draft);
const sortedParcours = allParcours.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const base = import.meta.env.BASE_URL;

const tracks = sortedParcours
  .map((p) => {
    const slug = p.id.replace(/\/index$/, '');
    const key = Object.keys(stopsModules).find((k) => k.includes(slug));
    const stops = key ? stopsModules[key].default : [];
    return {
      slug,
      circuit: p.data.circuit,
      title: p.data.title,
      dateLabel: p.data.date.toLocaleDateString('fr-CA', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      }),
      href: `${base}parcours/${slug}`,
      color: colorForCircuit(p.data.circuit),
      stops,
    };
  })
  .filter((t) => t.stops.length > 0);

// Stops du circuit courant (pour la barre latérale qui reste focalisée).
const currentStops = tracks.find((t) => t.circuit === entry.data.circuit)?.stops ?? [];
---

<ParcoursLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  series={entry.data.series}
  circuit={entry.data.circuit}
  date={entry.data.date}
  duration={entry.data.duration}
  distance={entry.data.distance}
  stopsCount={entry.data.stopsCount}
  organizer={entry.data.organizer}
  summary={entry.data.summary}
>
  {tracks.length > 0 && (
    <section class="map-section">
      <div class="map-grid">
        <div class="map-col">
          <TourMap
            tracks={tracks}
            currentCircuit={entry.data.circuit}
            height="640px"
            id="parcours-map"
          />
        </div>
        <div class="sidebar-col">
          <StopsList stops={currentStops} mapId="parcours-map" />
        </div>
      </div>
    </section>
  )}

  <section class="prose">
    <Content />
  </section>
</ParcoursLayout>

<style>
  .map-section {
    margin-bottom: var(--space-8);
  }

  .map-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-5);
  }

  @media (max-width: 1000px) {
    .map-grid {
      grid-template-columns: 1fr;
    }
    .sidebar-col {
      max-height: 500px;
      overflow-y: auto;
    }
  }
</style>
