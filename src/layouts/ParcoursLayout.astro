---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  series: string;
  circuit: string;
  date: Date;
  duration: string;
  distance: string;
  stopsCount: number;
  organizer: string;
  summary: string;
}

const { title, subtitle, series, circuit, date, duration, distance, stopsCount, organizer, summary } = Astro.props;

const dateFormatted = date.toLocaleDateString('fr-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — ${organizer}`} description={summary}>
  <Header />

  <article class="parcours">
    <header class="masthead">
      <div class="container">
        <div class="overline">
          <span>{organizer} · {series}</span>
        </div>
        <h1 class="title">
          Circuit n° <span class="roman">{circuit}</span>
        </h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <div class="meta-row">
          <div class="meta-item">
            <span class="meta-label">Date</span>
            <span class="meta-value">{dateFormatted}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Durée</span>
            <span class="meta-value">{duration}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Distance</span>
            <span class="meta-value">{distance}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Arrêts</span>
            <span class="meta-value">{stopsCount}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="parcours-body container">
      <slot />
    </div>
  </article>

  <Footer />
</BaseLayout>

<style>
  .masthead {
    padding: var(--space-7) 0 var(--space-6);
    border-bottom: 1px solid var(--rule);
    background:
      linear-gradient(180deg, var(--paper-soft) 0%, var(--cream) 100%);
  }

  .masthead .overline { margin-bottom: var(--space-4); }

  .masthead .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .masthead .title .roman {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .masthead .subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--ink-soft);
    font-weight: 400;
    margin-bottom: var(--space-5);
    max-width: 640px;
    line-height: 1.4;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: baseline;
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-soft);
  }

  .meta-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .meta-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--ink);
  }

  .parcours-body {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  @media (max-width: 600px) {
    .masthead { padding: var(--space-6) 0 var(--space-5); }
    .meta-row { gap: var(--space-4); }
    .meta-value { font-size: 1.1rem; }
  }
</style>
