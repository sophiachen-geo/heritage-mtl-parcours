---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface PhotoEntry {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: PhotoEntry[];
  columns?: 2 | 3 | 4;
}

const { photos, columns = 3 } = Astro.props;
---

{photos.length > 0 && (
  <section class="photo-gallery" data-columns={columns}>
    <div class="gallery-grid">
      {photos.map((photo, i) => (
        <figure class="gallery-item">
          <button class="gallery-trigger" data-index={i} aria-label={`Agrandir la photo ${i + 1}`}>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 800]}
              sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw"
              loading="lazy"
              decoding="async"
            />
          </button>
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <div class="lightbox" id="gallery-lightbox" hidden>
      <button class="lightbox-close" aria-label="Fermer">×</button>
      <button class="lightbox-prev" aria-label="Précédente">‹</button>
      <button class="lightbox-next" aria-label="Suivante">›</button>
      <div class="lightbox-content">
        <img class="lightbox-img" alt="" />
        <p class="lightbox-caption"></p>
      </div>
    </div>
  </section>
)}

<style>
  .photo-gallery {
    margin: var(--space-7) 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: var(--space-4);
  }

  .photo-gallery[data-columns="2"] { --cols: 2; }
  .photo-gallery[data-columns="3"] { --cols: 3; }
  .photo-gallery[data-columns="4"] { --cols: 4; }

  .gallery-item {
    margin: 0;
  }

  .gallery-trigger {
    background: none;
    border: 1px solid var(--rule-soft);
    padding: 0;
    cursor: zoom-in;
    display: block;
    width: 100%;
    overflow: hidden;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1), border-color 200ms ease;
  }

  .gallery-trigger:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .gallery-trigger img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-trigger:hover img {
    transform: scale(1.03);
  }

  .gallery-item figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin-top: var(--space-2);
    line-height: 1.4;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(28, 24, 20, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }

  .lightbox[hidden] { display: none; }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border: 1px solid var(--rule);
  }

  .lightbox-caption {
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: center;
    max-width: 600px;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: all 200ms ease;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
  }

  .lightbox-close {
    top: var(--space-5);
    right: var(--space-5);
  }

  .lightbox-prev { left: var(--space-5); }
  .lightbox-next { right: var(--space-5); }

  @media (max-width: 700px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr !important;
    }
    .lightbox-prev, .lightbox-next {
      bottom: var(--space-5);
      top: auto;
    }
    .lightbox-prev { left: var(--space-4); }
    .lightbox-next { right: var(--space-4); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const galleries = document.querySelectorAll<HTMLElement>('.photo-gallery');
    galleries.forEach((gallery) => {
      const triggers = gallery.querySelectorAll<HTMLButtonElement>('.gallery-trigger');
      const lightbox = gallery.querySelector<HTMLElement>('.lightbox');
      if (!lightbox) return;
      const lbImg = lightbox.querySelector<HTMLImageElement>('.lightbox-img');
      const lbCaption = lightbox.querySelector<HTMLElement>('.lightbox-caption');
      const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-close');
      const prevBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev');
      const nextBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-next');

      const items = Array.from(triggers).map((t) => {
        const img = t.querySelector('img');
        const fig = t.closest('figure');
        const cap = fig?.querySelector('figcaption');
        return {
          src: img?.currentSrc || img?.src || '',
          alt: img?.alt || '',
          caption: cap?.textContent || '',
        };
      });

      let idx = 0;
      const show = (i: number) => {
        idx = (i + items.length) % items.length;
        if (lbImg) {
          lbImg.src = items[idx].src;
          lbImg.alt = items[idx].alt;
        }
        if (lbCaption) lbCaption.textContent = items[idx].caption;
      };
      const open = (i: number) => {
        show(i);
        lightbox.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lightbox.setAttribute('hidden', '');
        document.body.style.overflow = '';
      };

      triggers.forEach((t) => t.addEventListener('click', () => open(parseInt(t.dataset.index || '0'))));
      closeBtn?.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => show(idx - 1));
      nextBtn?.addEventListener('click', () => show(idx + 1));
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (lightbox.hasAttribute('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
    });
  });
</script>
