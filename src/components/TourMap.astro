---
interface Stop {
  num: number;
  name: string;
  lat: number;
  lng: number;
  time?: string;
  duration?: number;
  type?: 'start' | 'end' | 'intermediate';
  desc?: string;
}

interface Track {
  slug: string;
  circuit: string;
  title: string;
  dateLabel: string;
  href: string;
  color: string;
  stops: Stop[];
}

interface Props {
  tracks: Track[];
  currentCircuit?: string;
  height?: string;
  id?: string;
}

const { tracks, currentCircuit, height = '600px', id = 'tour-map' } = Astro.props;
const tracksJson = JSON.stringify(tracks);
---

<div class="map-container" style={`--map-height: ${height};`}>
  <div
    id={id}
    class="leaflet-host"
    data-tracks={tracksJson}
    data-current={currentCircuit ?? ''}
  ></div>
  <div class="compass" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="45" fill="none" stroke="#7c2d12" stroke-width="0.5" opacity="0.4" />
      <circle cx="50" cy="50" r="35" fill="none" stroke="#7c2d12" stroke-width="0.3" opacity="0.3" />
      <path d="M 50 10 L 54 50 L 50 46 L 46 50 Z" fill="#7c2d12" />
      <path d="M 50 90 L 54 50 L 50 54 L 46 50 Z" fill="#1c1814" opacity="0.7" />
      <text x="50" y="9" text-anchor="middle" font-family="Cormorant Garamond" font-size="8" fill="#7c2d12" font-weight="600">N</text>
      <text x="50" y="98" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">S</text>
      <text x="6" y="53" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">O</text>
      <text x="94" y="53" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">E</text>
    </svg>
  </div>
  <div class="loading-route" id={`${id}-loading`}>Tracé en cours…</div>
</div>

<div class="map-legend" aria-label="Légende des parcours sur la carte">
  <span class="legend-title">Parcours</span>
  <ul class="legend-list">
    {tracks.map((t) => (
      <li class:list={['legend-item', currentCircuit && t.circuit === currentCircuit && 'is-current']}>
        <a href={t.href}>
          <span class="swatch" style={`background: ${t.color};`} aria-hidden="true"></span>
          <span class="legend-label">Circuit n° {t.circuit}</span>
          <span class="legend-date">{t.dateLabel}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .map-container {
    position: relative;
    height: var(--map-height);
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--cream);
  }

  .leaflet-host {
    height: 100%;
    width: 100%;
    background: var(--cream);
  }

  /* Tuiles teintées sépia pour l'effet patrimonial */
  :global(.leaflet-tile-pane) {
    filter: sepia(0.32) saturate(0.78) hue-rotate(-8deg) contrast(0.96) brightness(1.02);
  }

  /* Marqueurs personnalisés (couleur définie par variable --c sur l'inner div) */
  :global(.stop-marker) {
    background: transparent !important;
    border: none !important;
  }

  :global(.stop-marker-inner) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--c, var(--azure));
    color: var(--c, var(--azure));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(28, 24, 20, 0.25);
    transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease;
    position: relative;
  }

  :global(.stop-marker.start .stop-marker-inner) {
    background: var(--c);
    color: var(--paper);
  }

  :global(.stop-marker.end .stop-marker-inner) {
    background: var(--c);
    color: var(--paper);
    box-shadow: 0 0 0 2px var(--paper) inset, 0 2px 8px rgba(28, 24, 20, 0.25);
  }

  :global(.stop-marker.dim .stop-marker-inner) {
    opacity: 0.5;
    transform: scale(0.85);
  }

  :global(.stop-marker.dim:hover .stop-marker-inner) {
    opacity: 1;
    transform: scale(0.95);
  }

  :global(.stop-marker.active .stop-marker-inner) {
    transform: scale(1.2);
    opacity: 1;
  }

  /* Popups */
  :global(.leaflet-popup-content-wrapper) {
    background: var(--paper);
    border-radius: 0;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--rule);
    padding: 0;
  }

  :global(.leaflet-popup-content) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-body);
    width: 280px !important;
  }

  :global(.leaflet-popup-tip) {
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  :global(.popup-circuit) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-1);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.popup-circuit-swatch) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  :global(.popup-num) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }

  :global(.popup-name) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: var(--space-2);
    color: var(--ink);
  }

  :global(.popup-meta) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-transform: uppercase;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule-soft);
  }

  :global(.popup-desc) {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  :global(.popup-link) {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.leaflet-control-attribution) {
    background: rgba(253, 249, 238, 0.85) !important;
    backdrop-filter: blur(4px);
    font-family: var(--font-mono) !important;
    font-size: 0.62rem !important;
    color: var(--ink-muted) !important;
  }

  :global(.leaflet-control-attribution a) { color: var(--accent) !important; }

  :global(.leaflet-control-zoom) {
    border: 1px solid var(--rule) !important;
    box-shadow: var(--shadow-md) !important;
  }

  :global(.leaflet-control-zoom a) {
    background: var(--paper) !important;
    color: var(--ink) !important;
    border-bottom: 1px solid var(--rule-soft) !important;
    font-family: var(--font-display) !important;
    font-weight: 500 !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background: var(--cream) !important;
  }

  /* Rose des vents décorative */
  .compass {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 400;
    width: 64px;
    height: 64px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    pointer-events: none;
  }

  .compass svg { width: 46px; height: 46px; }

  .loading-route {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    z-index: 500;
    transition: opacity 400ms ease;
  }

  .loading-route.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Légende, sous la carte */
  .map-legend {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: none;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4) var(--space-5);
  }

  .legend-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .legend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .legend-item a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 200ms ease;
  }

  .legend-item a:hover { color: var(--ink); }

  .legend-item.is-current a {
    color: var(--ink);
    font-weight: 600;
  }

  .swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(28, 24, 20, 0.2);
  }

  .legend-item.is-current .swatch {
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 3px currentColor;
  }

  .legend-label {
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .legend-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  @media (max-width: 540px) {
    .compass { width: 50px; height: 50px; }
    .compass svg { width: 36px; height: 36px; }
    .map-legend { padding: var(--space-3) var(--space-4); }
  }
</style>

<script>
  // Charger Leaflet dynamiquement, puis initialiser chaque carte présente sur la page
  function loadLeaflet(): Promise<typeof import('leaflet')> {
    return new Promise((resolve, reject) => {
      if ((window as any).L) return resolve((window as any).L);
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = () => resolve((window as any).L);
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  type Stop = {
    num: number;
    name: string;
    lat: number;
    lng: number;
    time?: string;
    duration?: number;
    type?: 'start' | 'end' | 'intermediate';
    desc?: string;
  };

  type Track = {
    slug: string;
    circuit: string;
    title: string;
    dateLabel: string;
    href: string;
    color: string;
    stops: Stop[];
  };

  function pad(n: number) { return String(n).padStart(2, '0'); }

  function escapeHtml(s: string) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function initMap(host: HTMLElement) {
    const L = await loadLeaflet();
    const tracks: Track[] = JSON.parse(host.dataset.tracks || '[]');
    const current = host.dataset.current || '';
    if (!tracks.length) return;

    const map = L.map(host, {
      zoomControl: true,
      attributionControl: true,
      scrollWheelZoom: false,
      dragging: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Activation du défilement à la molette uniquement après un clic
    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());

    function makeIcon(stop: Stop, track: Track, isCurrent: boolean) {
      const typeCls = stop.type === 'start' ? 'start' : (stop.type === 'end' ? 'end' : 'intermediate');
      const dimCls = isCurrent ? '' : 'dim';
      return L.divIcon({
        className: `stop-marker ${typeCls} ${dimCls}`.trim(),
        html: `<div class="stop-marker-inner" style="--c: ${track.color}">${stop.num}</div>`,
        iconSize: [36, 36],
        iconAnchor: [18, 18],
        popupAnchor: [0, -18],
      });
    }

    // Index des marqueurs : circuit -> num -> Marker
    const markerIndex: Record<string, Record<number, any>> = {};
    const allLatLngs: [number, number][] = [];

    for (const track of tracks) {
      const isCurrent = current ? track.circuit === current : true;
      markerIndex[track.circuit] = {};

      for (const s of track.stops) {
        const m = L.marker([s.lat, s.lng], { icon: makeIcon(s, track, isCurrent) }).addTo(map);
        const meta = [s.time, s.duration ? `${s.duration} min` : null].filter(Boolean).join(' · ');
        const showCircuitHeader = !current || track.circuit !== current;
        const popupHtml = `
          ${showCircuitHeader ? `
            <div class="popup-circuit">
              <span class="popup-circuit-swatch" style="background: ${track.color}"></span>
              Circuit n° ${escapeHtml(track.circuit)} · ${escapeHtml(track.dateLabel)}
            </div>
          ` : ''}
          <div class="popup-num">Arrêt ${pad(s.num)}</div>
          <div class="popup-name">${escapeHtml(s.name)}</div>
          ${meta ? `<div class="popup-meta">${escapeHtml(meta)}</div>` : ''}
          ${s.desc ? `<div class="popup-desc">${escapeHtml(s.desc)}</div>` : ''}
          ${showCircuitHeader ? `<a class="popup-link" href="${escapeHtml(track.href)}">Voir ce circuit →</a>` : ''}
        `;
        m.bindPopup(popupHtml, { closeButton: true, autoPan: true });
        markerIndex[track.circuit][s.num] = m;
        allLatLngs.push([s.lat, s.lng]);
      }
    }

    // Cadrage automatique sur l'ensemble des arrêts de tous les parcours
    if (allLatLngs.length) {
      map.fitBounds(L.latLngBounds(allLatLngs), { padding: [60, 60] });
    }

    // Récupérer le tracé piéton via OSRM pour chaque parcours, en parallèle.
    // Repli sur lignes droites par parcours en cas d'échec individuel.
    const loadingEl = document.getElementById(host.id + '-loading');
    const routePromises = tracks.map(async (track) => {
      const isCurrent = current ? track.circuit === current : true;
      const baseOpacity = isCurrent ? 0.85 : 0.4;
      const glowOpacity = isCurrent ? 0.08 : 0.04;
      const coords = track.stops.map(s => `${s.lng},${s.lat}`).join(';');
      const url = `https://router.project-osrm.org/route/v1/foot/${coords}?overview=full&geometries=geojson`;

      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error('OSRM unavailable');
        const data = await res.json();
        if (!data.routes || !data.routes.length) throw new Error('No route');
        const latlngs = data.routes[0].geometry.coordinates.map((c: [number, number]) => [c[1], c[0]] as [number, number]);
        L.polyline(latlngs, { color: track.color, weight: 8, opacity: glowOpacity, lineCap: 'round' }).addTo(map);
        L.polyline(latlngs, { color: track.color, weight: 3, opacity: baseOpacity, dashArray: '1, 8', lineCap: 'round' }).addTo(map);
      } catch {
        const latlngs = track.stops.map(s => [s.lat, s.lng] as [number, number]);
        L.polyline(latlngs, {
          color: track.color,
          weight: 2.5,
          opacity: isCurrent ? 0.6 : 0.3,
          dashArray: '2, 8',
        }).addTo(map);
      }
    });

    Promise.allSettled(routePromises).then(() => {
      if (!loadingEl) return;
      loadingEl.classList.add('hidden');
    });

    // Exposer le pilotage par numéro pour la barre latérale.
    // open() bascule sur le marqueur correspondant du circuit courant si fourni,
    // sinon sur le premier circuit qui contient ce numéro.
    (host as any)._tourMap = {
      open: (n: number, circuit?: string) => {
        const targetCircuit = circuit ?? current ?? tracks[0]?.circuit;
        const m = targetCircuit ? markerIndex[targetCircuit]?.[n] : undefined;
        if (!m) return;
        map.flyTo(m.getLatLng(), 17, { duration: 0.7 });
        m.openPopup();
      },
    };
  }

  document.querySelectorAll<HTMLElement>('.leaflet-host').forEach(initMap);
</script>
