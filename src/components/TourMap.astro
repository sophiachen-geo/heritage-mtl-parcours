---
interface Stop {
  num: number;
  name: string;
  lat: number;
  lng: number;
  time?: string;
  duration?: number;
  type?: 'start' | 'end' | 'intermediate';
  desc?: string;
}

interface Props {
  stops: Stop[];
  height?: string;
  id?: string;
}

const { stops, height = '600px', id = 'tour-map' } = Astro.props;
const stopsJson = JSON.stringify(stops);
---

<div class="map-container" style={`--map-height: ${height};`}>
  <div id={id} class="leaflet-host" data-stops={stopsJson}></div>
  <div class="compass" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="45" fill="none" stroke="#7c2d12" stroke-width="0.5" opacity="0.4" />
      <circle cx="50" cy="50" r="35" fill="none" stroke="#7c2d12" stroke-width="0.3" opacity="0.3" />
      <path d="M 50 10 L 54 50 L 50 46 L 46 50 Z" fill="#7c2d12" />
      <path d="M 50 90 L 54 50 L 50 54 L 46 50 Z" fill="#1c1814" opacity="0.7" />
      <text x="50" y="9" text-anchor="middle" font-family="Cormorant Garamond" font-size="8" fill="#7c2d12" font-weight="600">N</text>
      <text x="50" y="98" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">S</text>
      <text x="6" y="53" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">O</text>
      <text x="94" y="53" text-anchor="middle" font-family="Cormorant Garamond" font-size="6" fill="#1c1814" opacity="0.7">E</text>
    </svg>
  </div>
  <div class="loading-route" id={`${id}-loading`}>Tracé en cours…</div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .map-container {
    position: relative;
    height: var(--map-height);
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--cream);
  }

  .leaflet-host {
    height: 100%;
    width: 100%;
    background: var(--cream);
  }

  /* Tuiles teintées sépia pour l'effet patrimonial */
  :global(.leaflet-tile-pane) {
    filter: sepia(0.32) saturate(0.78) hue-rotate(-8deg) contrast(0.96) brightness(1.02);
  }

  /* Marqueurs personnalisés */
  :global(.stop-marker) {
    background: transparent !important;
    border: none !important;
  }

  :global(.stop-marker-inner) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--azure);
    color: var(--azure);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(28, 24, 20, 0.25);
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  :global(.stop-marker.start .stop-marker-inner) {
    background: var(--jade);
    border-color: var(--jade);
    color: var(--paper);
  }

  :global(.stop-marker.end .stop-marker-inner) {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--paper);
  }

  :global(.stop-marker.active .stop-marker-inner) {
    transform: scale(1.2);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  /* Popups */
  :global(.leaflet-popup-content-wrapper) {
    background: var(--paper);
    border-radius: 0;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--rule);
    padding: 0;
  }

  :global(.leaflet-popup-content) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-body);
    width: 280px !important;
  }

  :global(.leaflet-popup-tip) {
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  :global(.popup-num) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }

  :global(.popup-name) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: var(--space-2);
    color: var(--ink);
  }

  :global(.popup-meta) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-transform: uppercase;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule-soft);
  }

  :global(.popup-desc) {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  :global(.leaflet-control-attribution) {
    background: rgba(253, 249, 238, 0.85) !important;
    backdrop-filter: blur(4px);
    font-family: var(--font-mono) !important;
    font-size: 0.62rem !important;
    color: var(--ink-muted) !important;
  }

  :global(.leaflet-control-attribution a) { color: var(--accent) !important; }

  :global(.leaflet-control-zoom) {
    border: 1px solid var(--rule) !important;
    box-shadow: var(--shadow-md) !important;
  }

  :global(.leaflet-control-zoom a) {
    background: var(--paper) !important;
    color: var(--ink) !important;
    border-bottom: 1px solid var(--rule-soft) !important;
    font-family: var(--font-display) !important;
    font-weight: 500 !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background: var(--cream) !important;
  }

  /* Rose des vents décorative */
  .compass {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 400;
    width: 64px;
    height: 64px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    pointer-events: none;
  }

  .compass svg { width: 46px; height: 46px; }

  .loading-route {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    z-index: 500;
    transition: opacity 400ms ease;
  }

  .loading-route.hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 540px) {
    .compass { width: 50px; height: 50px; }
    .compass svg { width: 36px; height: 36px; }
  }
</style>

<script>
  // Charger Leaflet dynamiquement, puis initialiser chaque carte présente sur la page
  function loadLeaflet(): Promise<typeof import('leaflet')> {
    return new Promise((resolve, reject) => {
      if ((window as any).L) return resolve((window as any).L);
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = () => resolve((window as any).L);
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  type Stop = {
    num: number;
    name: string;
    lat: number;
    lng: number;
    time?: string;
    duration?: number;
    type?: 'start' | 'end' | 'intermediate';
    desc?: string;
  };

  function pad(n: number) { return String(n).padStart(2, '0'); }

  async function initMap(host: HTMLElement) {
    const L = await loadLeaflet();
    const stops: Stop[] = JSON.parse(host.dataset.stops || '[]');
    if (!stops.length) return;

    const map = L.map(host, {
      zoomControl: true,
      attributionControl: true,
      scrollWheelZoom: false,
      dragging: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Activation du défilement à la molette uniquement après un clic
    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());

    function makeIcon(stop: Stop) {
      const cls = stop.type === 'start' ? 'start' : (stop.type === 'end' ? 'end' : '');
      return L.divIcon({
        className: 'stop-marker ' + cls,
        html: `<div class="stop-marker-inner">${stop.num}</div>`,
        iconSize: [36, 36],
        iconAnchor: [18, 18],
        popupAnchor: [0, -18],
      });
    }

    const markers: Record<number, L.Marker> = {};
    stops.forEach((s) => {
      const m = L.marker([s.lat, s.lng], { icon: makeIcon(s) }).addTo(map);
      const meta = [s.time, s.duration ? `${s.duration} min` : null].filter(Boolean).join(' · ');
      const popupHtml = `
        <div class="popup-num">Arrêt ${pad(s.num)}</div>
        <div class="popup-name">${s.name}</div>
        ${meta ? `<div class="popup-meta">${meta}</div>` : ''}
        ${s.desc ? `<div class="popup-desc">${s.desc}</div>` : ''}
      `;
      m.bindPopup(popupHtml, { closeButton: true, autoPan: true });
      markers[s.num] = m;
    });

    // Cadrage automatique
    const bounds = L.latLngBounds(stops.map(s => [s.lat, s.lng]));
    map.fitBounds(bounds, { padding: [60, 60] });

    // Récupérer le tracé piéton via OSRM avec repli sur lignes droites
    const loadingEl = document.getElementById(host.id + '-loading');
    const coords = stops.map(s => `${s.lng},${s.lat}`).join(';');
    const url = `https://router.project-osrm.org/route/v1/foot/${coords}?overview=full&geometries=geojson`;

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error('OSRM unavailable');
      const data = await res.json();
      if (!data.routes || !data.routes.length) throw new Error('No route');

      const latlngs = data.routes[0].geometry.coordinates.map((c: [number, number]) => [c[1], c[0]] as [number, number]);
      L.polyline(latlngs, { color: '#7c2d12', weight: 8, opacity: 0.08, lineCap: 'round' }).addTo(map);
      L.polyline(latlngs, { color: '#7c2d12', weight: 3, opacity: 0.85, dashArray: '1, 8', lineCap: 'round' }).addTo(map);
      loadingEl?.classList.add('hidden');
    } catch {
      const latlngs = stops.map(s => [s.lat, s.lng] as [number, number]);
      L.polyline(latlngs, { color: '#7c2d12', weight: 2.5, opacity: 0.6, dashArray: '2, 8' }).addTo(map);
      if (loadingEl) {
        loadingEl.textContent = 'Tracé approximatif';
        setTimeout(() => loadingEl.classList.add('hidden'), 1500);
      }
    }

    // Exposer le pilotage par numéro pour la barre latérale
    (host as any)._tourMap = {
      open: (n: number) => {
        const m = markers[n];
        if (!m) return;
        map.flyTo(m.getLatLng(), 17, { duration: 0.7 });
        m.openPopup();
      }
    };
  }

  // Initialiser tous les conteneurs au chargement
  document.querySelectorAll<HTMLElement>('.leaflet-host').forEach(initMap);
</script>
